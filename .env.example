# Database Configuration (PostgreSQL running on port 4329)
DATABASE_URL="postgresql://postgres:bps@localhost:4329/admission_db?schema=public"
DIRECT_URL="postgresql://postgres:bps@localhost:4329/admission_db?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="bps"
POSTGRES_DB="admission_db"
POSTGRES_PORT=4329

# Next.js Application & Server (Port 3014)
PORT=3014
NEXTAUTH_URL="https://demo.admissionhere.in"
AUTH_URL="https://demo.admissionhere.in"
AUTH_TRUST_HOST="true"
AUTH_SECRET="default-secret-dev-random-admissions-hub-key"
NEXT_PUBLIC_APP_URL="https://demo.admissionhere.in"

# Optional AI / Search & Revalidation Secrets
OPENAI_API_KEY=""
REVALIDATION_SECRET="admission_secret_revalidate_2026"

